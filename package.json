{
  "name": "singularity-lab-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenvx run --strict -f .env.development -- next dev --turbopack",
    "build": "next build",
    "build:local": "dotenvx run --strict -f .env.development -- next build",
    "start": "next start",
    "start:local": "dotenvx run --strict -f .env.development -- next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "format:check": "prettier --check . --ignore-unknown",
    "format": "prettier --write . --ignore-unknown",
    "db:types": "node scripts/db-types.cjs",
    "db:types:local": "dotenvx run --strict -f .env.development -- node scripts/db-types.cjs",
    "db:migrate:docker": "node scripts/apply-local-migrations.cjs",
    "lint:logs": "node scripts/lint-logs.cjs",
    "lint:env": "node scripts/check-env-encrypted.cjs",
    "lint:workflows": "node scripts/check-workflow-notifications.cjs",
    "test": "jest --verbose --coverage",
    "test:vm-modules": "JEST_LOCAL_SQL=1 node --experimental-vm-modules node_modules/jest/bin/jest.js --verbose --coverage"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@mantine/core": "^7.17.8",
    "@mantine/hooks": "^7.17.0",
    "@mantine/notifications": "^7.17.8",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.119.2",
    "@tailwindcss/typography": "^0.5.19",
    "date-fns": "^4.4.0",
    "googleapis": "^168.0.0",
    "isomorphic-dompurify": "^2.35.0",
    "lucide-react": "^0.475.0",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-big-calendar": "^1.20.0",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-youtube": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "svix": "^1.61.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.38.2",
    "@electric-sql/pglite": "^0.5.17",
    "@eslint/eslintrc": "^3",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.30",
    "@types/react": "^19.3.1",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "autoprefixer": "^10.7.0",
    "eslint": "^9",
    "eslint-config-next": "^15.5.29",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jest": "^30.5.2",
    "postcss": "^8.5.33",
    "postcss-preset-mantine": "^1.17.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.10.1",
    "supabase": "^2.74.5",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.4.15",
    "typescript": "^5",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^6.1.5"
    },
    "next": {
      "postcss": "^8.5.23"
    }
  }
}
